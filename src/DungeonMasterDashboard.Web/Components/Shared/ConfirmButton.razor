@* A destructive action that asks before it runs, e.g. "Reset to defaults" or "Delete world". *@

@if (confirming)
{
    <span>@Question</span>
    <button type="button" class="btn btn-danger btn-sm" disabled="@Disabled" @onclick="ConfirmAsync">@ConfirmLabel</button>
    <button type="button" class="btn btn-link btn-sm" @onclick="() => confirming = false">Keep</button>
}
else
{
    <button type="button" class="btn btn-link btn-sm text-danger" disabled="@Disabled" @onclick="() => confirming = true">@Label</button>
}

@code {
    private bool confirming;

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public string Question { get; set; } = "";

    [Parameter, EditorRequired]
    public string ConfirmLabel { get; set; } = "";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    private async Task ConfirmAsync()
    {
        await OnConfirm.InvokeAsync();
        confirming = false;
    }
}
