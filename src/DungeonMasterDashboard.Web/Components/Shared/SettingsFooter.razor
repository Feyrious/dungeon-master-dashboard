@* Footer of the settings dialogs: an optional action on the left (reset, delete), errors,
   and Cancel/Save. Save submits the surrounding form. *@

<footer class="settings-dialog-footer">
    <div class="settings-reset">@ChildContent</div>
    @if (Error is not null)
    {
        <span class="text-danger small" role="alert">@Error</span>
    }
    <div class="settings-footer-actions">
        <button type="button" class="btn btn-outline-secondary" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="btn btn-primary" disabled="@(Busy || SaveDisabled)">@(Busy ? "Saving…" : SaveLabel)</button>
    </div>
</footer>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public bool SaveDisabled { get; set; }

    [Parameter]
    public string SaveLabel { get; set; } = "Save";

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
