# Copy to .env and fill in. .env is git-ignored.

# Shared key the web app uses to sign requests to the API (at least 32 characters).
# Generate one with: openssl rand -base64 48
API_SIGNING_KEY=

# Which released images to run with `docker compose pull`: latest, or a version such as
# 2026.10.30.1 from the GitHub releases.
IMAGE_TAG=latest

# Host port for the web app (bound to 127.0.0.1 only).
WEB_PORT=8080

# Only needed when using the bundled cloudflared service (--profile tunnel).
TUNNEL_TOKEN=
