# Normalise line endings
* text=auto eol=lf

# Windows-specific files keep CRLF
*.sln text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF (used inside containers)
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pfx binary
*.dll binary
*.exe binary
