# Copy to users.env and fill in. users.env is git-ignored.
# Accounts listed here are created on startup if they don't exist yet.
# Existing accounts are never changed, so after your first login you can change the
# password in the app and remove it from this file.
# Passwords need 6+ characters with an uppercase, lowercase, digit and symbol.

Auth__SeedUsers__0__Email=you@example.com
Auth__SeedUsers__0__Password=

# Add up to four more by increasing the index:
# Auth__SeedUsers__1__Email=
# Auth__SeedUsers__1__Password=
