# Copy to users.env and fill in the first user. users.env is git-ignored.
#
# Accounts listed here are created on startup if they don't exist yet; entries left
# empty are skipped. Existing accounts are never changed, so after your first login
# you can change the password in the app and clear it from this file.
# Passwords need 6+ characters with an uppercase, lowercase, digit and symbol.

Auth__SeedUsers__0__Email=
Auth__SeedUsers__0__Password=

# Up to four more (remove the leading "# "), increasing the index:
# Auth__SeedUsers__1__Email=
# Auth__SeedUsers__1__Password=
